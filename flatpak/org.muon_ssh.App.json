{
  "app-id": "org.muon_ssh.App",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "24.08",
  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.openjdk17"
  ],
  "default-branch": "stable",
  "command": "muon",
  "modules": [
    {
      "name": "openjdk",
      "buildsystem": "simple",
      "build-commands": [
        "/usr/lib/sdk/openjdk17/install.sh"
      ]
    },
    {
      "name": "muon",
      "buildsystem": "simple",
      "build-commands": [
        "mkdir -p /app/muon",
        "mkdir -p /app/bin",
        "mkdir -p /app/share/icons/hicolor/128x128/apps",
        "mkdir -p /app/share/applications",
        "cp muonssh_3.0.0.jar /app/muon",
        "cp muon /app/bin",
        "chmod 755 /app/bin/muon",
        "cp org.muon_ssh.App.png /app/share/icons/hicolor/128x128/apps",
        "cp org.muon_ssh.App.desktop /app/share/applications"
      ],
      "sources": [
        {
          "type": "file",
          "path": "../muon-app/target/muonssh_3.0.0.jar"
        },
        {
          "type": "file",
          "path": "muon"
        },
        {
          "type": "file",
          "path": "org.muon_ssh.App.png"
        },
        {
          "type": "file",
          "path": "org.muon_ssh.App.desktop"
        }
      ]
    }
  ],
  "finish-args": [
    "--env=PATH=/app/jre/bin:/usr/bin:/app/bin",
    "--share=ipc",
    "--socket=x11",
    "--share=network",
    "--filesystem=host",
    "--socket=wayland",
    "--socket=fallback-x11",
    "--device=dri",
    "--filesystem=home",
    "--filesystem=xdg-run/gnupg",
    "--talk-name=org.freedesktop.Notifications",
    "--socket=ssh-auth",
    "--talk-name=org.freedesktop.secrets",
    "--filesystem=xdg-config/kdeglobals:ro",
    "--talk-name=org.freedesktop.Flatpak"
  ]
}